# Build outputs
/build/*
!/build/.gitkeep

*.o
*.obj
*.bin
*.elf
# ...and the shared objects, which the same rule missed: `services/libc/libc.so`
# was committed by accident when step 6 landed, and a build output under version
# control is a binary that drifts from the source beside it.
*.so
*.img
*.iso
*.map
*.lst
*.sym
*.log

# Temporary files
*.tmp
*.swp
*~

# IDEs and editors
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

# WSL / NTFS "mark of the web" metadata sidecars
*:Zone.Identifier

# QEMU / runtime artifacts
*.qcow2
*.vmdk
serial.out

# Toolchain / local caches
.cache/
dist/
out/

# Local agent instructions
AGENTS.md

# Local agent state
.codex
.claude/
build/iris-disk.img

# Python bytecode.  `spec/` is run as scripts and imported only by its own
# lanes, so these caches are build output like any other — and `spec-exhaustive`
# importing `differential` is enough to create one on every gate run.
__pycache__/
*.pyc
